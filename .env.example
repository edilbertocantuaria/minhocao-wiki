# Copy this file to .env and fill in real values.
# The .env file must NEVER be committed.

# Database (optional: overrides the default postgres/postgres)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@db:5432/minhocao_wiki

# Secret key used to sign JWT tokens - generate with: openssl rand -hex 32
JWT_SECRET_KEY=change-this-to-a-random-secret

# Google OAuth Client ID (same value for API and Next.js build)
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
