# LLM and vector database configuration

OPENAI_API_KEY: "sk-XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
GEMINI_API_KEY: "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
PINECONE_API_KEY: "XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"

# Name of the index in Pinecone where the vectors will be stored
INDEX_NAME: "minhocao-wiki"

# PostgreSQL and auth configuration
# Local run (uvicorn): use localhost.
# Docker compose overrides DATABASE_URL to host `db` for the api container.
DATABASE_URL: "postgresql+psycopg2://postgres:postgres@localhost:5432/minhocao_wiki"
JWT_SECRET_KEY: "change-this-secret-in-production"
JWT_ALGORITHM: "HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES: 60